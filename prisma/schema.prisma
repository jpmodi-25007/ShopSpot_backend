generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

model User {
  id                   String             @id @default(uuid())
  email                String?            @unique
  mobile               String?            @unique
  password             String
  name                 String?
  avatarUrl            String?
  role                 UserRole           @default(CUSTOMER)
  languagePreference   String             @default("en")
  addressJson          Json?              @map("address")
  isEmailVerified      Boolean            @default(false)
  isMobileVerified     Boolean            @default(false)
  isActive             Boolean            @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  addresses            Address[]
  analyticsEvents      AnalyticsEvent[]
  auditLogs            AuditLog[]
  reports              ContentReport[]
  influencerProfile    InfluencerProfile?
  sentMessages         Message[]
  customerNegotiations Negotiation[]      @relation("CustomerNegotiations")
  notifications        Notification[]
  customerOrders       Order[]            @relation("CustomerOrders")
  refreshTokens        RefreshToken[]
  customerReservations Reservation[]      @relation("CustomerReservations")
  reviews              Review[]
  savedProducts        SavedProduct[]
  savedShops           SavedShop[]
  shop                 Shop?
  devices              UserDevice[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserDevice {
  id        String   @id @default(uuid())
  userId    String
  fcmToken  String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_devices")
}

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  iconUrl      String?
  parentId     String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  shops        Shop[]

  @@map("categories")
}

model Shop {
  id                    String               @id @default(uuid())
  ownerId               String               @unique
  name                  String
  slug                  String               @unique
  description           String?
  categoryId            String?
  logoUrl               String?
  coverImageUrl         String?
  address               String
  latitude              Float
  longitude             Float
  city                  String?
  state                 String?
  pincode               String?
  phone                 String?
  whatsapp              String?
  email                 String?
  gstNumber             String?
  isGstVerified         Boolean              @default(false)
  isKycVerified         Boolean              @default(false)
  verificationDocuments Json?
  businessHours         Json?
  rating                Decimal              @default(0) @db.Decimal(2, 1)
  reviewCount           Int                  @default(0)
  subscriptionTier      SubscriptionTier     @default(FREE)
  subscriptionExpiresAt DateTime?
  status                ShopStatus           @default(ACTIVE)
  isOpen                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  events                Event[]
  analyticsEvents       AnalyticsEvent[]
  ContentReport         ContentReport[]
  campaigns             InfluencerCampaign[]
  negotiations          Negotiation[]        @relation("ShopNegotiations")
  offers                Offer[]
  orders                Order[]              @relation("ShopOrders")
  products              Product[]
  promotionBanners      PromotionBanner[]
  purchaseOrders        PurchaseOrder[]
  reservations          Reservation[]        @relation("ShopReservations")
  reviews               Review[]
  savedByUsers          SavedShop[]
  category              Category?            @relation(fields: [categoryId], references: [id])
  owner                 User                 @relation(fields: [ownerId], references: [id])
  subscriptions         Subscription[]
  suppliers             Supplier[]

  @@map("shops")
}

model Product {
  id                String               @id @default(uuid())
  shopId            String
  name              String
  slug              String?
  description       String?
  categoryId        String?
  brand             String?
  mrp               Decimal?             @db.Decimal(10, 2)
  sellingPrice      Decimal              @db.Decimal(10, 2)
  currency          String               @default("INR")
  stockQuantity     Int                  @default(0)
  stockStatus       StockStatus          @default(IN_STOCK)
  lowStockThreshold Int                  @default(5)
  sku               String?
  barcode           String?
  attributes        Json?
  variants          Json?
  isActive          Boolean              @default(true)
  isFeatured        Boolean              @default(false)
  viewCount         Int                  @default(0)
  inquiryCount      Int                  @default(0)
  reservationCount  Int                  @default(0)
  tags              String[]             @default([])
  metaTitle         String?
  metaDescription   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  analyticsEvents   AnalyticsEvent[]
  reports           ContentReport[]
  campaigns         InfluencerCampaign[]
  mediaAssets       MediaAsset[]
  negotiations      Negotiation[]
  category          Category?            @relation(fields: [categoryId], references: [id])
  shop              Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  promotionBanners  PromotionBanner[]
  reservations      Reservation[]
  reviews           Review[]
  savedByUsers      SavedProduct[]
  stockHistory      StockHistory[]

  @@map("products")
}

model MediaAsset {
  id           String   @id @default(uuid())
  publicId     String   @unique
  secureUrl    String
  width        Int?
  height       Int?
  format       String?
  bytes        Int?
  resourceType String   @default("image")
  folder       String?
  entityType   String
  entityId     String
  isPrimary    Boolean  @default(false)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [entityId], references: [id], map: "media_product_fkey")

  @@index([entityType, entityId])
  @@index([publicId])
  @@map("media_assets")
}

model Offer {
  id          String   @id @default(uuid())
  shopId      String
  title       String
  description String?
  discountPct Decimal? @db.Decimal(5, 2)
  bannerUrl   String?
  startsAt    DateTime
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("offers")
}

model Negotiation {
  id                String            @id @default(uuid())
  productId         String
  shopId            String
  customerId        String
  initialPrice      Decimal           @db.Decimal(10, 2)
  offeredPrice      Decimal           @db.Decimal(10, 2)
  counterPrice      Decimal?          @db.Decimal(10, 2)
  finalPrice        Decimal?          @db.Decimal(10, 2)
  counterRound      Int               @default(0)
  status            NegotiationStatus @default(PENDING)
  customerMessage   String?
  shopkeeperMessage String?
  expiresAt         DateTime?
  acceptedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  messages          Message[]
  customer          User              @relation("CustomerNegotiations", fields: [customerId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  shop              Shop              @relation("ShopNegotiations", fields: [shopId], references: [id])
  reservations      Reservation[]

  @@map("negotiations")
}

model Message {
  id            String      @id @default(uuid())
  negotiationId String
  senderId      String
  senderRole    String
  messageType   MessageType @default(TEXT)
  content       String
  metadata      Json?
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Reservation {
  id            String            @id @default(uuid())
  negotiationId String?
  productId     String
  shopId        String
  customerId    String
  reservedPrice Decimal           @db.Decimal(10, 2)
  quantity      Int               @default(1)
  qrToken       String            @unique
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime
  visitedAt     DateTime?
  createdAt     DateTime          @default(now())
  customer      User              @relation("CustomerReservations", fields: [customerId], references: [id])
  negotiation   Negotiation?      @relation(fields: [negotiationId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  shop          Shop              @relation("ShopReservations", fields: [shopId], references: [id])

  @@map("reservations")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerId      String
  shopId          String
  items           Json
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryCharge  Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  deliveryAddress Json
  deliveryType    DeliveryType  @default(STANDARD)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentId       String?
  trackingInfo    Json?
  idempotencyKey  String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        User          @relation("CustomerOrders", fields: [customerId], references: [id])
  shop            Shop          @relation("ShopOrders", fields: [shopId], references: [id])
  reviews         Review[]

  @@map("orders")
}

model Review {
  id                 String   @id @default(uuid())
  shopId             String?
  productId          String?
  customerId         String
  orderId            String?
  rating             Int
  title              String?
  comment            String?
  images             String[] @default([])
  isVerifiedPurchase Boolean  @default(false)
  helpfulCount       Int      @default(0)
  isModerated        Boolean  @default(false)
  isPublic           Boolean  @default(false)
  moderationNote     String?
  createdAt          DateTime @default(now())
  customer           User     @relation(fields: [customerId], references: [id])
  order              Order?   @relation(fields: [orderId], references: [id])
  product            Product? @relation(fields: [productId], references: [id])
  shop               Shop?    @relation(fields: [shopId], references: [id])

  @@map("reviews")
}

model SavedProduct {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("saved_products")
}

model SavedShop {
  id        String   @id @default(uuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@map("saved_shops")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Subscription {
  id             String           @id @default(uuid())
  shopId         String
  planName       String
  planTier       SubscriptionTier
  price          Decimal          @db.Decimal(10, 2)
  billingCycle   String           @default("monthly")
  features       Json
  productLimit   Int?
  analyticsLevel String?
  adCredits      Int              @default(0)
  razorpaySubId  String?
  startedAt      DateTime?
  expiresAt      DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  shop           Shop             @relation(fields: [shopId], references: [id])

  @@map("subscriptions")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  shopId    String?
  productId String?
  userId    String?
  sessionId String?
  metadata  Json?
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id])
  shop      Shop?    @relation(fields: [shopId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("analytics_events")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model InfluencerProfile {
  id                 String               @id @default(uuid())
  userId             String               @unique
  displayName        String
  username           String               @unique
  bio                String?
  profileImage       String?
  city               String?
  latitude           Float?
  longitude          Float?
  languages          String[]             @default([])
  categories         String[]             @default([])
  instagramUrl       String?
  facebookUrl        String?
  youtubeUrl         String?
  followers          Int                  @default(0)
  avgViews           Int                  @default(0)
  avgStoryViews      Int                  @default(0)
  engagementRate     Decimal              @default(0) @db.Decimal(5, 2)
  avgLikes           Int                  @default(0)
  avgComments        Int                  @default(0)
  audienceLocation   Json?
  metricsSource      MetricsSource        @default(SELF_REPORTED)
  verificationStatus VerificationStatus   @default(PENDING)
  creatorScore       Int                  @default(0)
  rating             Decimal              @default(0) @db.Decimal(2, 1)
  completedCampaigns Int                  @default(0)
  onTimeRate         Decimal              @default(0) @db.Decimal(5, 2)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  assignments        CampaignAssignment[]
  bids               InfluencerBid[]
  user               User                 @relation(fields: [userId], references: [id])

  @@map("influencer_profiles")
}

model InfluencerCampaign {
  id                  String               @id @default(uuid())
  shopkeeperId        String
  shopId              String
  productId           String?
  title               String
  description         String
  platforms           String[]             @default([])
  contentTypes        String[]             @default([])
  creatorCount        Int                  @default(1)
  budgetType          BudgetType           @default(PER_CREATOR)
  budgetMin           Decimal              @db.Decimal(10, 2)
  budgetMax           Decimal              @db.Decimal(10, 2)
  totalBudget         Decimal?             @db.Decimal(10, 2)
  city                String?
  radiusKm            Float?
  targetCategories    String[]             @default([])
  targetLanguages     String[]             @default([])
  minFollowers        Int?
  minAvgViews         Int?
  minEngagement       Decimal?             @db.Decimal(5, 2)
  preferredStartDate  DateTime?
  preferredEndDate    DateTime?
  applicationDeadline DateTime?
  deliverables        Json?
  requirements        String?
  status              CampaignStatus       @default(DRAFT)
  committedAmount     Decimal              @default(0) @db.Decimal(10, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assignments         CampaignAssignment[]
  bids                InfluencerBid[]
  product             Product?             @relation(fields: [productId], references: [id])
  shop                Shop                 @relation(fields: [shopId], references: [id])

  @@map("influencer_campaigns")
}

model InfluencerBid {
  id                    String                 @id @default(uuid())
  campaignId            String
  influencerId          String
  proposedAmount        Decimal                @db.Decimal(10, 2)
  availableDate         DateTime
  deliveryDate          DateTime
  estimatedMinReach     Int?
  estimatedMaxReach     Int?
  proposal              String?
  deliverablesConfirmed Json?
  status                BidStatus              @default(SUBMITTED)
  isShortlisted         Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  assignment            CampaignAssignment?
  counterOffers         CampaignCounterOffer[]
  campaign              InfluencerCampaign     @relation(fields: [campaignId], references: [id])
  influencer            InfluencerProfile      @relation(fields: [influencerId], references: [id])

  @@map("influencer_bids")
}

model CampaignCounterOffer {
  id        String        @id @default(uuid())
  bidId     String
  senderId  String
  amount    Decimal       @db.Decimal(10, 2)
  message   String?
  expiresAt DateTime
  status    String        @default("pending")
  createdAt DateTime      @default(now())
  bid       InfluencerBid @relation(fields: [bidId], references: [id])

  @@map("campaign_counter_offers")
}

model CampaignAssignment {
  id                  String                 @id @default(uuid())
  campaignId          String
  bidId               String                 @unique
  shopkeeperId        String
  influencerId        String
  agreedAmount        Decimal                @db.Decimal(10, 2)
  scheduledDate       DateTime
  deliveryDate        DateTime
  paymentStatus       CampaignPaymentStatus  @default(NOT_CONFIRMED)
  contentStatus       ContentStatus          @default(NOT_STARTED)
  submittedContentUrl String?
  proofImageUrl       String?
  trackingCode        String                 @unique @default(uuid())
  publishedAt         DateTime?
  caption             String?
  notes               String?
  status              String                 @default("active")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  bid                 InfluencerBid          @relation(fields: [bidId], references: [id])
  campaign            InfluencerCampaign     @relation(fields: [campaignId], references: [id])
  influencer          InfluencerProfile      @relation(fields: [influencerId], references: [id])
  performance         CampaignPerformance?
  ratings             CampaignRating[]
  trackingLinks       CampaignTrackingLink[]

  @@map("campaign_assignments")
}

model CampaignRating {
  id           String             @id @default(uuid())
  assignmentId String
  raterRole    String
  raterId      String
  scores       Json
  comment      String?
  createdAt    DateTime           @default(now())
  assignment   CampaignAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, raterRole])
  @@map("campaign_ratings")
}

model CampaignPerformance {
  id             String             @id @default(uuid())
  assignmentId   String             @unique
  views          Int                @default(0)
  likes          Int                @default(0)
  comments       Int                @default(0)
  shares         Int                @default(0)
  saves          Int                @default(0)
  linkClicks     Int                @default(0)
  productViews   Int                @default(0)
  offerRequests  Int                @default(0)
  reservations   Int                @default(0)
  reportedVisits Int                @default(0)
  lastSyncedAt   DateTime?
  createdAt      DateTime           @default(now())
  assignment     CampaignAssignment @relation(fields: [assignmentId], references: [id])

  @@map("campaign_performance")
}

model CampaignTrackingLink {
  id           String             @id @default(uuid())
  code         String             @unique @default(uuid())
  assignmentId String
  productId    String?
  shopId       String?
  clickCount   Int                @default(0)
  createdAt    DateTime           @default(now())
  assignment   CampaignAssignment @relation(fields: [assignmentId], references: [id])

  @@map("campaign_tracking_links")
}

model Supplier {
  id             String          @id @default(uuid())
  shopId         String
  name           String
  location       String
  rating         Decimal         @default(0) @db.Decimal(2, 1)
  ratingLabel    String?
  deliveryTime   String?
  qualityMatch   String?
  email          String
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  supplierId   String
  shopId       String
  poNumber     String    @unique
  details      String
  status       String    @default("Pending")
  isDelivered  Boolean   @default(false)
  expectedDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("purchase_orders")
}

model StockHistory {
  id        String   @id @default(uuid())
  productId String
  quantity  Int
  reason    String
  note      String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model ContentReport {
  id         String         @id @default(uuid())
  title      String
  image      String?
  productId  String?
  shopId     String?
  reporterId String
  reason     String
  reports    Int            @default(1)
  status     ReportStatus   @default(PENDING)
  severity   ReportSeverity @default(LOW)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  product    Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter   User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  shop       Shop?          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("content_reports")
}

model PromotionBanner {
  id           String    @id @default(uuid())
  imageUrl     String
  title        String?
  shopId       String?
  productId    String?
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop         Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("promotion_banners")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  isActive    Boolean  @default(true)
  shopId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

enum UserRole {
  CUSTOMER
  SHOPKEEPER
  INFLUENCER
  ADMIN
}

enum ShopStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
  ELITE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum NegotiationStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MessageType {
  TEXT
  IMAGE
  PRICE_OFFER
  PRICE_COUNTER
  DEAL_ACCEPTED
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryType {
  STANDARD
  EXPRESS
  SELF_PICKUP
}

enum MetricsSource {
  SELF_REPORTED
  VERIFIED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  BIDDING_OPEN
  BIDDING_CLOSED
  CREATOR_SELECTED
  ASSIGNED
  PAYMENT_PENDING
  IN_PROGRESS
  CONTENT_SUBMITTED
  SHOPKEEPER_REVIEW
  POSTED
  COMPLETED
  CANCELLED
  DISPUTED
  EXPIRED
}

enum BidStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum BudgetType {
  PER_CREATOR
  TOTAL
}

enum CampaignPaymentStatus {
  NOT_CONFIRMED
  ADVANCE_PAID
  FULLY_PAID
  DISPUTED
  CONFIRMATION_PENDING
}

enum ContentStatus {
  NOT_STARTED
